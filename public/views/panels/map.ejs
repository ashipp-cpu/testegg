<div data-panel="map" class="map-layout">
  <div class="map-col-main">
    <section class="panel">
      <div class="panel-header"><h2>The City</h2></div>
      <p class="hint">Click a square for details. Bigger squares are major locations; small ones are minor. Your current location is highlighted.</p>

      <div class="sector-grid">
        <% sectors.forEach(function (sector) { %>
          <div class="sector-box">
            <span class="sector-label">Sector <%= sector.number %></span>
            <% if (sector.locations.length === 0) { %>
              <p class="sector-empty">Unexplored</p>
            <% } else { %>
              <div class="sector-locations">
                <% sector.locations.forEach(function (loc) {
                     var isHere = loc.id === character.location_id;
                %>
                  <div class="location-tile <%= loc.tier === 'major' ? 'location-tile-major' : 'location-tile-minor' %> <%= isHere ? 'location-tile-here' : '' %> <%= loc.controlling_tribe_name ? 'location-tile-claimed' : '' %>"
                       data-location="<%= loc.key %>" tabindex="0" title="<%= loc.name %>">
                    <span class="location-tile-name"><%= loc.name %></span>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    </section>

    <section class="panel">
      <div class="panel-header"><h2>Outside the City</h2></div>
      <div class="sector-locations outside-city-grid">
        <% outside.forEach(function (loc) {
             var isHere = loc.id === character.location_id;
        %>
          <div class="location-tile <%= loc.tier === 'major' ? 'location-tile-major' : 'location-tile-minor' %> <%= isHere ? 'location-tile-here' : '' %> <%= loc.controlling_tribe_name ? 'location-tile-claimed' : '' %>"
               data-location="<%= loc.key %>" tabindex="0" title="<%= loc.name %>">
            <span class="location-tile-name"><%= loc.name %></span>
          </div>
        <% }); %>
      </div>
    </section>

    <div class="map-legend">
      <span><span class="legend-dot legend-dot-here"></span>You are here</span>
      <span><span class="legend-dot legend-dot-claimed"></span>Tribe-held</span>
      <span><span class="legend-dot legend-dot-neutral"></span>Unclaimed</span>
      <span><span class="legend-swatch legend-swatch-major"></span>Major location</span>
      <span><span class="legend-swatch legend-swatch-minor"></span>Minor location</span>
    </div>
  </div>

  <aside class="map-detail-panel">
    <% locations.forEach(function (loc) {
         var isHere = loc.id === character.location_id;
    %>
      <div class="panel location-detail <%= isHere ? 'active' : '' %>" data-location-detail="<%= loc.key %>">
        <div class="panel-header">
          <h2><%= loc.name %></h2>
          <% if (isHere) { %><span class="badge badge-tribe">You are here</span><% } %>
        </div>
        <p class="hint">
          <%= loc.sector_number ? ('Sector ' + loc.sector_number) : 'Outside the city' %>
          &middot; <%= loc.tier === 'major' ? 'Major location' : 'Minor location' %>
        </p>
        <p class="description"><%= loc.description %></p>
        <p>
          <% if (loc.controlling_tribe_name) { %>
            <span class="badge badge-tribe"><%= loc.controlling_tribe_name %></span>
          <% } else { %>
            <span class="badge">Unclaimed</span>
          <% } %>
        </p>
      </div>
    <% }); %>
  </aside>
</div>
