<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Sign In' }) %></head>
<body class="auth-page">
  <main class="auth-card">
    <p class="eyebrow">Prototype &middot; Season Zero</p>
    <h1 class="display">Survive</h1>
    <p class="tagline">The world ended. Whoever's left has to make their own rules.</p>
    <% if (error) { %>
      <p class="form-error"><%= error %></p>
    <% } %>
    <form method="POST" action="/login" class="stack">
      <div class="field">
        <label for="username">Callsign</label>
        <input type="text" id="username" name="username" maxlength="20" required autofocus placeholder="e.g. Ashline">
      </div>
      <button type="submit" class="btn btn-primary btn-block">Enter the ruins</button>
    </form>
  </main>
</body>
</html>
