<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Survive — Sign In</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <div class="auth-box">
    <h1>Survive</h1>
    <p class="tagline">The world ended. Whoever's left has to make their own rules.</p>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <form method="POST" action="/login">
      <label for="username">Callsign</label>
      <input type="text" id="username" name="username" maxlength="20" required autofocus>
      <button type="submit">Enter</button>
    </form>
  </div>
</body>
</html>
