<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: character.name }) %></head>
<body>
  <div class="app-shell">
    <aside class="sheet-panel">
      <div class="sheet-header">
        <h2><%= character.name %></h2>
        <span class="badge badge-tribe"><%= membership.tribe_name %></span>
      </div>
      <p class="background-tag"><%= background.name %></p>
      <p class="appearance"><%= character.appearance_text %></p>

      <div class="vitals">
        <div class="vital">
          <span class="vital-label">HP</span>
          <span class="vital-value"><%= character.hp %></span>
        </div>
        <div class="vital">
          <span class="vital-label">Energy</span>
          <span class="vital-value"><%= character.energy %></span>
        </div>
      </div>

      <h3 class="sheet-subheading">Skills</h3>
      <ul class="skill-list">
        <% skills.forEach(function(skill) { %>
          <li><span><%= skill.name %></span><span class="skill-level"><%= skill.level %></span></li>
        <% }); %>
      </ul>

      <h3 class="sheet-subheading">Stats</h3>
      <dl class="stats-grid">
        <div><dt>STR</dt><dd><%= character.stat_strength %></dd></div>
        <div><dt>QCK</dt><dd><%= character.stat_quickness %></dd></div>
        <div><dt>WIT</dt><dd><%= character.stat_wits %></dd></div>
        <div><dt>CHM</dt><dd><%= character.stat_charm %></dd></div>
        <div><dt>GRT</dt><dd><%= character.stat_grit %></dd></div>
      </dl>

      <form method="POST" action="/logout"><button type="submit" class="btn btn-ghost btn-block">Log out</button></form>
    </aside>

    <main class="scene-panel">
      <h1><%= territory.name %></h1>
      <p class="description"><%= territory.description %></p>

      <div id="chat-log" class="chat-log">
        <% history.forEach(function(msg) { %>
          <p class="chat-line chat-<%= msg.type %>">
            <% if (msg.type === 'emote') { %>
              <span class="sender"><%= msg.sender_name %></span> <%= msg.body %>
            <% } else { %>
              <span class="sender"><%= msg.sender_name %>:</span> <%= msg.body %>
            <% } %>
          </p>
        <% }); %>
      </div>

      <form id="chat-form" class="chat-form">
        <input type="text" id="chat-input" autocomplete="off" maxlength="500"
               placeholder="Say something, or /me to act it out...">
        <button type="submit" class="btn btn-primary">Send</button>
      </form>
    </main>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/chat.js"></script>
</body>
</html>
