<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'New Character' }) %></head>
<body>
  <main class="wizard">
    <div class="step-indicator">
      <span class="step done">1 &middot; Callsign</span>
      <span class="step current">2 &middot; Character</span>
      <span class="step">3 &middot; Tribe</span>
    </div>

    <h1>Who were you, before?</h1>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>

    <form method="POST" action="/characters" class="stack">
      <div class="field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" value="<%= form.name %>" maxlength="30" required
               placeholder="What do people call you?">
      </div>

      <div class="field">
        <label for="appearance_text">Appearance</label>
        <textarea id="appearance_text" name="appearance_text" rows="2" required
                  placeholder="How do you look, move, dress?"><%= form.appearance_text %></textarea>
      </div>

      <div class="field">
        <label for="origin_story">Where did you come from?</label>
        <textarea id="origin_story" name="origin_story" rows="3" required
                  placeholder="How did you survive this long?"><%= form.origin_story %></textarea>
      </div>

      <fieldset class="field">
        <legend>Background</legend>
        <p class="hint">This shapes your starting stats and skills.</p>
        <div class="card-grid">
          <% backgrounds.forEach(function(bg) {
               var skillBonuses = JSON.parse(bg.skill_bonuses);
               var skillKeys = Object.keys(skillBonuses);
          %>
            <label class="option-card">
              <input type="radio" name="background_key" value="<%= bg.key %>"
                     <%= form.background_key === bg.key ? 'checked' : '' %> required>
              <span class="option-card-title"><%= bg.name %></span>
              <span class="option-card-body"><%= bg.blurb %></span>
              <span class="option-card-tags">
                <% skillKeys.forEach(function(key) { %>
                  <span class="tag">+<%= skillBonuses[key] %> <%= key.charAt(0).toUpperCase() + key.slice(1) %></span>
                <% }); %>
              </span>
            </label>
          <% }); %>
        </div>
      </fieldset>

      <button type="submit" class="btn btn-primary btn-block">Continue</button>
    </form>
  </main>
</body>
</html>
