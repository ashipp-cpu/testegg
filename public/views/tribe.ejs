<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: tribe.name }) %></head>
<body>
<%
  var recallByCharacter = {};
  openRecalls.forEach(function (r) { recallByCharacter[r.member.character_id] = r; });

  var leader = members.find(function (m) { return m.office === 'leader'; });
  var congressMembers = members.filter(function (m) { return m.office === 'congress'; });

  var controllingTribeName = null;
  if (territory.controlling_tribe_id === tribe.id) {
    controllingTribeName = tribe.name;
  } else if (territory.controlling_tribe_id) {
    var foreign = allTribes.find(function (t) { return t.id === territory.controlling_tribe_id; });
    controllingTribeName = foreign ? foreign.name : 'Unknown';
  }

  var iAmCandidateForLeader = leaderElection && leaderElection.candidates.some(function (c) { return c.character_id === character.id; });
  var iAmCandidateForCongress = congressElection && congressElection.candidates.some(function (c) { return c.character_id === character.id; });
%>
  <div class="tribe-page">
    <%- include('partials/topNav', { active: 'tribe' }) %>

    <header class="tribe-header">
      <h1><%= tribe.name %></h1>
      <p class="tagline"><%= tribe.ideology_text %></p>
      <p class="hint"><%= members.length %> member<%= members.length === 1 ? '' : 's' %></p>
    </header>

    <% if (error) { %><p class="form-error"><%= error %></p><% } %>

    <div class="tribe-grid-layout">
      <div class="tribe-col-main">

        <section class="panel">
          <div class="panel-header"><h2>Leadership</h2></div>
          <div class="seat-grid">
            <div class="seat-card">
              <span class="seat-role">Leader</span>
              <% if (leader) { %>
                <span class="seat-name"><%= leader.name %></span>
                <% var leaderRecall = recallByCharacter[leader.character_id]; %>
                <% if (leader.character_id === character.id) { %>
                  <span class="hint">That's you.</span>
                <% } else if (leaderRecall) { %>
                  <p class="hint"><%= leaderRecall.supportCount %> supporting recall</p>
                  <form method="POST" action="/tribe/recall/<%= leaderRecall.election.id %>/<%= leaderRecall.iSupport ? 'retract' : 'vote' %>">
                    <button type="submit" class="btn btn-ghost btn-small"><%= leaderRecall.iSupport ? 'Retract recall vote' : 'Support recall' %></button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/tribe/recall">
                    <input type="hidden" name="target_character_id" value="<%= leader.character_id %>">
                    <button type="submit" class="btn btn-ghost btn-small">Start recall vote</button>
                  </form>
                <% } %>
              <% } else { %>
                <span class="seat-name seat-vacant">Vacant</span>
                <% if (membership.office === 'member' && !iAmCandidateForLeader) { %>
                  <form method="POST" action="/tribe/elections/leader/nominate">
                    <button type="submit" class="btn btn-primary btn-small">Run for Leader</button>
                  </form>
                <% } %>
              <% } %>
            </div>

            <% for (var i = 0; i < 3; i++) { %>
              <div class="seat-card">
                <span class="seat-role">Congress</span>
                <% if (congressMembers[i]) {
                     var cm = congressMembers[i];
                     var congressRecall = recallByCharacter[cm.character_id];
                %>
                  <span class="seat-name"><%= cm.name %></span>
                  <% if (cm.character_id === character.id) { %>
                    <span class="hint">That's you.</span>
                  <% } else if (congressRecall) { %>
                    <p class="hint"><%= congressRecall.supportCount %> supporting recall</p>
                    <form method="POST" action="/tribe/recall/<%= congressRecall.election.id %>/<%= congressRecall.iSupport ? 'retract' : 'vote' %>">
                      <button type="submit" class="btn btn-ghost btn-small"><%= congressRecall.iSupport ? 'Retract recall vote' : 'Support recall' %></button>
                    </form>
                  <% } else { %>
                    <form method="POST" action="/tribe/recall">
                      <input type="hidden" name="target_character_id" value="<%= cm.character_id %>">
                      <button type="submit" class="btn btn-ghost btn-small">Start recall vote</button>
                    </form>
                  <% } %>
                <% } else { %>
                  <span class="seat-name seat-vacant">Vacant</span>
                  <% if (i === congressMembers.length && membership.office === 'member' && !iAmCandidateForCongress) { %>
                    <form method="POST" action="/tribe/elections/congress/nominate">
                      <button type="submit" class="btn btn-primary btn-small">Run for Congress</button>
                    </form>
                  <% } %>
                <% } %>
              </div>
            <% } %>
          </div>
        </section>

        <% if (leaderElection) { %>
          <section class="panel">
            <div class="panel-header"><h2>Leader Election</h2></div>
            <p class="hint">One vote each. First candidate past a majority wins the seat.</p>
            <% leaderElection.candidates.forEach(function (c) {
                 var iVoted = leaderElection.myVotes.indexOf(c.character_id) !== -1;
            %>
              <div class="list-row">
                <span><%= c.name %></span>
                <span class="list-row-actions">
                  <span class="vote-count"><%= c.voteCount %> vote<%= c.voteCount === 1 ? '' : 's' %></span>
                  <form method="POST" action="/tribe/elections/<%= leaderElection.id %>/<%= iVoted ? 'retract' : 'vote' %>">
                    <input type="hidden" name="candidate_character_id" value="<%= c.character_id %>">
                    <button type="submit" class="btn <%= iVoted ? 'btn-ghost' : 'btn-primary' %> btn-small"><%= iVoted ? 'Retract' : 'Vote' %></button>
                  </form>
                </span>
              </div>
            <% }); %>
          </section>
        <% } %>

        <% if (congressElection) { %>
          <section class="panel">
            <div class="panel-header"><h2>Congress Election</h2></div>
            <p class="hint">Back up to 3 candidates. Seats fill once a majority of the tribe has voted.</p>
            <% congressElection.candidates.forEach(function (c) {
                 var iVoted = congressElection.myVotes.indexOf(c.character_id) !== -1;
                 var atLimit = congressElection.myVotes.length >= 3;
            %>
              <div class="list-row">
                <span><%= c.name %></span>
                <span class="list-row-actions">
                  <span class="vote-count"><%= c.voteCount %> vote<%= c.voteCount === 1 ? '' : 's' %></span>
                  <% if (iVoted) { %>
                    <form method="POST" action="/tribe/elections/<%= congressElection.id %>/retract">
                      <input type="hidden" name="candidate_character_id" value="<%= c.character_id %>">
                      <button type="submit" class="btn btn-ghost btn-small">Retract</button>
                    </form>
                  <% } else if (!atLimit) { %>
                    <form method="POST" action="/tribe/elections/<%= congressElection.id %>/vote">
                      <input type="hidden" name="candidate_character_id" value="<%= c.character_id %>">
                      <button type="submit" class="btn btn-primary btn-small">Back</button>
                    </form>
                  <% } %>
                </span>
              </div>
            <% }); %>
          </section>
        <% } %>

        <section class="panel">
          <div class="panel-header"><h2>Territory</h2></div>
          <p><strong><%= territory.name %></strong> —
            <% if (!territory.controlling_tribe_id) { %>
              <span class="hint">unclaimed</span>
            <% } else { %>
              <span class="hint">held by <%= controllingTribeName %></span>
            <% } %>
          </p>
          <% if (canManage && territory.controlling_tribe_id !== tribe.id) { %>
            <form method="POST" action="/tribe/territory/claim">
              <button type="submit" class="btn btn-primary btn-small">
                <%= territory.controlling_tribe_id ? 'Contest Territory' : 'Claim Territory' %>
              </button>
            </form>
          <% } %>
        </section>

        <section class="panel">
          <div class="panel-header"><h2>Policy</h2></div>
          <p class="policy-text"><%= tribe.policy_text || 'No policy set yet.' %></p>
          <% if (canManage) { %>
            <form method="POST" action="/tribe/policy" class="stack">
              <textarea name="policy_text" rows="3" maxlength="2000" placeholder="What does your tribe stand for?"><%= tribe.policy_text %></textarea>
              <button type="submit" class="btn btn-ghost btn-small">Save Policy</button>
            </form>
          <% } %>
        </section>

        <section class="panel">
          <div class="panel-header"><h2>Alliances &amp; Rivalries</h2></div>
          <p class="hint">Your tribe's own read on others — not a mutual treaty yet.</p>
          <% if (diplomacy.length === 0) { %>
            <p class="hint">No declared stances.</p>
          <% } %>
          <% diplomacy.forEach(function (d) { %>
            <div class="list-row">
              <span><%= d.other_tribe_name %></span>
              <span class="stance-pill stance-<%= d.stance %>"><%= d.stance %></span>
            </div>
          <% }); %>
          <% if (canManage) { %>
            <form method="POST" action="/tribe/diplomacy" class="form-row">
              <select name="other_tribe_id">
                <% allTribes.forEach(function (t) { %>
                  <option value="<%= t.id %>"><%= t.name %></option>
                <% }); %>
              </select>
              <select name="stance">
                <option value="neutral">Neutral</option>
                <option value="ally">Ally</option>
                <option value="rival">Rival</option>
                <option value="war">War</option>
              </select>
              <button type="submit" class="btn btn-ghost btn-small">Set Stance</button>
            </form>
          <% } %>
        </section>

        <section class="panel">
          <div class="panel-header"><h2>Membership</h2></div>
          <% members.forEach(function (m) { %>
            <div class="list-row">
              <span><%= m.name %> <span class="hint">— <%= m.background_name %></span></span>
              <span class="badge <%= m.office !== 'member' ? 'badge-tribe' : '' %>"><%= m.office %></span>
            </div>
          <% }); %>
        </section>
      </div>

      <div class="tribe-col-side">
        <section class="panel">
          <div class="panel-header"><h2>Announcements</h2></div>
          <% if (announcements.length === 0) { %>
            <p class="hint">Nothing posted yet.</p>
          <% } %>
          <% announcements.forEach(function (a) { %>
            <div class="announcement">
              <p><%= a.body %></p>
              <p class="hint">— <%= a.author_name %></p>
            </div>
          <% }); %>
          <% if (canManage) { %>
            <form method="POST" action="/tribe/announcements" class="stack">
              <textarea name="body" rows="2" maxlength="1000" placeholder="Post an announcement to the tribe"></textarea>
              <button type="submit" class="btn btn-ghost btn-small">Post</button>
            </form>
          <% } %>
        </section>

        <section class="panel">
          <div class="panel-header"><h2>News</h2></div>
          <% if (news.length === 0) { %>
            <p class="hint">Nothing has happened yet.</p>
          <% } %>
          <% news.slice().reverse().forEach(function (n) { %>
            <p class="news-item"><%= n.body %></p>
          <% }); %>
        </section>

        <section class="panel">
          <div class="panel-header"><h2>Tribe Chat</h2></div>
          <%- include('partials/chatWidget', {
            history: chatHistory,
            channel: 'tribe',
            placeholder: "Talk to your tribe..."
          }) %>
        </section>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/chat.js"></script>
</body>
</html>
